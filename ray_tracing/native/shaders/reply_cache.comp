#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=32) in;
layout(set=0,binding=0) uniform accelerationStructureEXT cacheAS;
layout(std430,binding=1) buffer Vertices {float vertices[];};
layout(std430,binding=2) buffer Receipt {uint receipt[];};
layout(std430,binding=3) buffer Control {uint control[];};
layout(std430,binding=4) buffer Tokens {uint tokens[];};
layout(std430,binding=5) buffer Nodes {uint nodes[];};
layout(push_constant) uniform Query {uint operation,key0,key1,key2,key3,position,count,first,index;} cfg;
const vec2 corners[6]=vec2[6](vec2(0,0),vec2(0,1),vec2(1,1),vec2(0,0),vec2(1,1),vec2(1,0));
uvec4 advance(uvec4 key,uint token,uint position){
    return (key^uvec4(token,token+0x9e3779b9u,token^position,token+position*668265263u))*uvec4(16777619u,2246822519u,3266489917u,374761393u);
}
vec2 cell(uvec4 key){return 4.0*vec2(key.x&65535u,key.y&65535u);}
void main(){
    uint lane=gl_LocalInvocationID.x;uvec4 key=uvec4(cfg.key0,cfg.key1,cfg.key2,cfg.key3);
    if(cfg.operation==0u){
        uint count=control[1]-cfg.index;
        for(uint i=0u;i<min(cfg.count,count);i++){
            uint slot=(cfg.first+i)%65536u,token=tokens[528u+cfg.index+i],at=slot*8u;
            if(lane<4u)nodes[at+lane]=key[lane];
            if(lane==4u)nodes[at+4u]=cfg.position+i;
            if(lane==5u)nodes[at+5u]=token;
            if(lane==6u)nodes[at+6u]=1u;
            if(lane==7u)nodes[at+7u]=0u;
            if(lane<6u){vec2 xy=cell(key)+corners[lane];uint p=(slot*6u+lane)*3u;vertices[p]=xy.x;vertices[p+1u]=xy.y;vertices[p+2u]=0;}
            key=advance(key,token,cfg.position+i);
        }return;
    }
    if(lane!=0u)return;
    uint hits=0u,queries=0u,leaf=0xffffffffu;control[1]=0u;
    for(uint i=0u;i<cfg.count&&control[2]!=0u;i++){
        rayQueryEXT query;queries++;
        rayQueryInitializeEXT(query,cacheAS,gl_RayFlagsNoOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,255u,vec3(cell(key)+vec2(.25,.5),1),0,vec3(0,0,-1),2);
        while(rayQueryProceedEXT(query))if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT){
            uint slot=rayQueryGetIntersectionInstanceCustomIndexEXT(query,false)*256u+rayQueryGetIntersectionPrimitiveIndexEXT(query,false)/2u,at=slot*8u;
            if(nodes[at+6u]==1u&&nodes[at+4u]==cfg.position+i&&all(equal(uvec4(nodes[at],nodes[at+1u],nodes[at+2u],nodes[at+3u]),key)))rayQueryConfirmIntersectionEXT(query);
        }
        if(rayQueryGetIntersectionTypeEXT(query,true)!=gl_RayQueryCommittedIntersectionTriangleEXT)break;
        leaf=rayQueryGetIntersectionInstanceCustomIndexEXT(query,true)*256u+rayQueryGetIntersectionPrimitiveIndexEXT(query,true)/2u;
        uint token=nodes[leaf*8u+5u];tokens[528u+hits]=token;control[0]=token;hits++;
        if(token==control[4]||token==control[5])control[2]=0u;
        key=advance(key,token,cfg.position+i);
    }
    control[1]=hits;receipt[0]=hits;receipt[1]=leaf;receipt[2]=queries;receipt[3]=queries>hits?1u:0u;
    for(uint i=0u;i<4u;i++)receipt[4u+i]=key[i];
}
