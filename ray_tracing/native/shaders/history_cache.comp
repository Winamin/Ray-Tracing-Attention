#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=32) in;
layout(set=0,binding=0) uniform accelerationStructureEXT historyCacheAS;
layout(std430,binding=1) readonly buffer Nodes { uint nodes[]; };
layout(std430,binding=2) readonly buffer Queries { uint queries[]; };
layout(std430,binding=3) buffer Results { uint results[]; };
layout(push_constant) uniform Config { uint count; } cfg;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=cfg.count)return;
    uint at=i*12u;
    vec2 chart=uintBitsToFloat(uvec2(queries[at+8u],queries[at+9u]));
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,historyCacheAS,gl_RayFlagsNoOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,
                         255u,vec3(chart,1),0,vec3(0,0,-1),2);
    while(rayQueryProceedEXT(ray)) {
        if(rayQueryGetIntersectionTypeEXT(ray,false)!=gl_RayQueryCandidateIntersectionTriangleEXT)continue;
        uint slot=rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false)*16u+
                  rayQueryGetIntersectionPrimitiveIndexEXT(ray,false)/2u;
        uint n=slot*12u;
        bool valid=nodes[n+11u]!=0u&&nodes[n+10u]==queries[at+10u];
        for(uint k=0u;k<8u;k++)valid=valid&&nodes[n+k]==queries[at+k];
        if(valid)rayQueryConfirmIntersectionEXT(ray);
    }
    results[i]=rayQueryGetIntersectionTypeEXT(ray,true)==gl_RayQueryCommittedIntersectionTriangleEXT?
        rayQueryGetIntersectionInstanceCustomIndexEXT(ray,true)*16u+
        rayQueryGetIntersectionPrimitiveIndexEXT(ray,true)/2u:0xffffffffu;
}
