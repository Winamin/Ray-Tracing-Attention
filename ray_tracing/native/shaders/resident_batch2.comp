float16_t decodeFloat(const in DecodeFloat block,const in uint bc[2],const in uint ci[2]){
    return float16_t(mappedWeight(bc[0],bc[1]*256u+ci[1]));
}
float16_t decodeHalf(const in DecodeHalf block,const in uint bc[2],const in uint ci[2]){
    return float16_t(mappedWeight(bc[0],bc[1]*256u+ci[1]));
}
f16vec4 decodeQ4Vector(const in DecodeQ4 block,const in uint bc[2],const in uint ci[2]){
