f16vec4 decodeHalfVector(const in DecodeHalf block,const in uint bc[2],const in uint ci[2]){
    uint axis=bc[1]*256u+ci[1];return f16vec4(mappedWeight(bc[0],axis),mappedWeight(bc[0],axis+1u),mappedWeight(bc[0],axis+2u),mappedWeight(bc[0],axis+3u));
}
uint upMetadata(){return upFormat==0xffffffffu?parameters[blockBase()+20u]:upFormat;}
float16_t decodeUpQ4(const in DecodeQ4 block,const in uint bc[2],const in uint ci[2]){
    uint i=ci[1];vec2 d=upScales[(i/32u)*(BM+2u)+bc[0]%BM];uint packed=block.raw[4u+(i/64u)*8u+(i%32u)/4u];uint q=(packed>>((i%4u)*8u+(i%64u)/32u*4u))&15u;return float16_t(d.x*float(q)-d.y);
}
f16vec4 decodeUpQ4Vector(const in DecodeQ4 block,const in uint bc[2],const in uint ci[2]){
    uint i=ci[1];vec2 d=upScales[(i/32u)*(BM+2u)+bc[0]%BM];uint packed=block.raw[4u+(i/64u)*8u+(i%32u)/4u];uvec4 q=(uvec4(packed)>>uvec4(0,8,16,24)>>((i%64u)/32u*4u))&15u;return f16vec4(d.x*vec4(q)-d.y);
