#include "resident_common.glsl"
layout(constant_id=1) const uint branch=0u;
layout(std430,binding=22) readonly buffer MatrixInput {float16_t matrixInput[];};
layout(std430,binding=36) readonly buffer CachedControls {float16_t cachedControls[];};
float coefficient(uint row,uint axis){
    uint base=blockBase(),offset=parameters[branch==0u?base+36u:base+35u];
    uint metadata=coefficientFormat==0xffffffffu?parameters[branch==0u?base+40u:base+39u]:coefficientFormat;
