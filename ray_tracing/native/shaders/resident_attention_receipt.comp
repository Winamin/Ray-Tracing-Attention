void mergeAttention(uint row,uint head,uint lane){
    uint groups=groupCount(row);if(cfg.index==0u&&groups==1u)return;
    if(lane==0u){
        groupFailure=0u;mergeState[0]=-1.0/0.0;mergeState[1]=0.0;mergeState[2]=0.0;
        for(uint g=0u;g<groups;g++){
            uint record=recordIndex(row,g,head),at=record*RECORD_WORDS;
            if(!recordFits(record)){attentionFailure();break;}
            float m=uintBitsToFloat(attentionReceipts[at]),z=uintBitsToFloat(attentionReceipts[at+1u]);
            uint expected=min(BLOCK,availablePositions(row)-g*BLOCK);
            if(attentionReceipts[at+2u]!=expected||(attentionReceipts[at+7u]&19u)!=19u||
               !finiteValue(z)||z<=0.0||!finiteValue(m)||attentionReceipts[at+5u]!=expected)attentionFailure();
            mergeState[0]=max(mergeState[0],m);
        }
    }
    barrier();
    if(groupFailure!=0u)return;
    // Intersect the coordinate equivalence classes across every age block.
    // Merge representatives in producer shared storage, then restore the output.
    uint firstAt=recordIndex(row,0u,head)*RECORD_WORDS;
    for(uint axis=lane;axis<DH;axis+=128u){
        uint rep=axis;
        if(attentionReceipts[firstAt+9u+COVERAGE_WORDS]<DH)for(uint p=0u;p<axis;p++){
            if(receiptAxis(firstAt,p)!=receiptAxis(firstAt,axis))continue;
            bool same=true;
            for(uint g=1u;g<groups;g++){
                uint at=recordIndex(row,g,head)*RECORD_WORDS;
                if(receiptAxis(at,p)!=receiptAxis(at,axis)){same=false;break;}
            }
            if(same){rep=p;break;}
        }
        valueMap[axis]=rep;
    }
    barrier();
    if(lane==0u){tokenCount=0u;for(uint axis=0u;axis<DH;axis++)if(valueMap[axis]==axis)keyHash[tokenCount++]=axis;}
    barrier();
    precise float signal0=0.0,signal1=0.0,correction0=0.0,correction1=0.0;
    for(uint group=0u;group<groups;group++){
        uint record=recordIndex(row,group,head),at=record*RECORD_WORDS;
        if(!recordFits(record)){if(lane==0u)attentionFailure();barrier();return;}
        uint count=attentionReceipts[at+2u],expected=min(BLOCK,availablePositions(row)-group*BLOCK);
        for(uint w=lane;w<COVERAGE_WORDS;w+=128u){uint n=min(32u,count>w*32u?count-w*32u:0u);uint mask=n==32u?0xffffffffu:n==0u?0u:(1u<<n)-1u;if(attentionReceipts[at+8u+w]!=mask)attentionFailure();}
        for(uint axis=lane;axis<DH;axis+=128u){uint rep=receiptAxis(at,axis);if(rep>axis||receiptAxis(at,rep)!=rep)attentionFailure();}
        barrier();if(groupFailure!=0u)return;
        if(lane==0u){
            float m=uintBitsToFloat(attentionReceipts[at]),z=uintBitsToFloat(attentionReceipts[at+1u]);
            float b=m==mergeState[0]?1.0:exp(m-mergeState[0]);
            precise float term=z*b;
            accurateAdd(mergeState[1],mergeState[2],term);
            accurateAdd(mergeState[1],mergeState[2],fma(z,b,-term));mergeState[3]=b;
        }
        barrier();
        if(lane<tokenCount){uint rep=receiptAxis(at,keyHash[lane]);float u=uintBitsToFloat(attentionReceipts[at+U_OFFSET+receiptRank(at,rep)]);precise float term=u*mergeState[3];accurateAdd(signal0,correction0,term);accurateAdd(signal0,correction0,fma(u,mergeState[3],-term));if(!finiteValue(signal0))attentionFailure();}
        if(lane+128u<tokenCount){uint rep=receiptAxis(at,keyHash[lane+128u]);float u=uintBitsToFloat(attentionReceipts[at+U_OFFSET+receiptRank(at,rep)]);precise float term=u*mergeState[3];accurateAdd(signal1,correction1,term);accurateAdd(signal1,correction1,fma(u,mergeState[3],-term));if(!finiteValue(signal1))attentionFailure();}
        barrier();if(groupFailure!=0u)return;
    }
    if(lane==0u){statisticAdd(15u,tokenCount);mergeState[1]-=mergeState[2];uint at=(row*max(H,uint(RT_ATTENTION_HEADS))+head)*2u;physical[at]=mergeState[0]+20.0;physical[at+1u]=mergeState[1];}
    barrier();
    if(lane<tokenCount)addressTile[keyHash[lane]]=(signal0-correction0)/mergeState[1];
    if(lane+128u<tokenCount)addressTile[keyHash[lane+128u]]=(signal1-correction1)/mergeState[1];
    barrier();
    for(uint axis=lane;axis<DH;axis+=128u){uint channel=head*DH+axis;detector[row*A+channel]=finalHeadSignal(row,channel,addressTile[valueMap[axis]],1.0);}
}

#ifdef RT_LOCAL_CLASSES
#if defined(RT_PREFILL_KEY)
#include "resident_attention_prefill_key.glsl"
#elif defined(RT_PREFILL_VALUE)
#include "resident_attention_prefill_value.glsl"
#else
#include "resident_attention_local.glsl"
#endif
#endif

void main(){
    if(stopped())return;
    uint lane=gl_LocalInvocationID.x;
    if(operation==2u){
        uint row=gl_WorkGroupID.x*gl_WorkGroupSize.x+lane;
        if(row<cfg.rows)hits[row*(cfg.capacity+1u)]=0u;
        if(row==0u)control[6]=0u;
        return;
    }
    uint row=gl_WorkGroupID.y;
    if(row>=cfg.rows)return;
    if(absolute(0u)<cfg.checkpoint||availablePositions(row)==0u){if(lane==0u)atomicOr(control[3],ATTENTION_ERROR);return;}
#ifdef RT_PREFILL_KEY
    if(operation==3u){
        if(gl_WorkGroupSize.x!=KEY_SLICES*Q_BATCH*32u||gl_SubgroupSize!=32u){if(lane==0u)atomicOr(control[3],ATTENTION_ERROR);return;}
        keyAttention(row,gl_WorkGroupID.x,lane);return;
    }
#endif
#ifdef RT_PREFILL_VALUE
    if((control[3]&ATTENTION_ERROR)!=0u)return;
#endif
    if(operation==0u){
        // Each KV/Q pair owns a complete subgroup. Merge and initialization
        // retain local size 128 independently of the producer's subgroup map.
        if(gl_WorkGroupSize.x!=KV_BATCH*Q_BATCH*32u||gl_SubgroupSize!=32u){if(lane==0u)atomicOr(control[3],ATTENTION_ERROR);return;}
#ifdef RT_LOCAL_CLASSES
        localAttention(row,gl_WorkGroupID.x,lane);
#else
#ifdef RT_ATTENTION_TC
        if(attentionTC!=0u)fusedAttentionTC(row,gl_WorkGroupID.x,lane);
        else fusedAttention(row,gl_WorkGroupID.x,lane);
#else
        fusedAttention(row,gl_WorkGroupID.x,lane);
#endif
#endif
    }
    else if(operation==1u){
        if((control[3]&ATTENTION_ERROR)!=0u)return;
        uint head=gl_WorkGroupID.x;if(head>=headCount())return;
        mergeAttention(row,head,lane);
    }
}
