    if(operation==8u){for(uint q=lane;q<cfg.rows;q+=128u)if(hits[q*(cfg.capacity+1u)]!=min(absolute(q)+1u,cfg.capacity))atomicOr(control[3],8u);if(lane==0u){control[8u+cfg.capacity]=8u;control[9u+cfg.capacity]=control[6];control[10u+cfg.capacity]=1u;control[7]+=control[6]*SHARED_PAIRS;}return;}
    if(operation==9u){uint bits=job*128u+lane;if(bits<65536u){uint measured=floatBitsToUint(scalarValue(bits));measured=(measured+32767u+((measured>>16u)&1u))&0xffff0000u;control[scalarCacheOffset()+bits]=measured;}return;}
