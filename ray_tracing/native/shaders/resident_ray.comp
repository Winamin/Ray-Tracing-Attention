            for(uint j=0u;j<n;j++){uint hit=hits[at+first+j+1u];if(lane<hd)signal0+=weights[j]*pathCoordinate(hit,head*hd+lane,true);if(lane+128u<hd)signal1+=weights[j]*pathCoordinate(hit,head*hd+lane+128u,true);}barrier();
