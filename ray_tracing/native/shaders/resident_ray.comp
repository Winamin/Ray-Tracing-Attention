        if(lane<hd){uint ch=head*hd+lane;detector[row*A+ch]=signal0/max(reference,1e-30)*(RT_ATTENTION_GATE==1?detectorSigmoid(feedForward[row*W+ch]):1.0);}
        if(lane+128u<hd){uint ch=head*hd+lane+128u;detector[row*A+ch]=signal1/max(reference,1e-30)*(RT_ATTENTION_GATE==1?detectorSigmoid(feedForward[row*W+ch]):1.0);}return;}
    if(operation==5u){if(row>=min(256u,wordResult[4096u]))return;uint pair=job*128u+lane,word=wordResult[WORD_QUEUE+row];if(pair>=D/2u)return;
        vec2 value=wordTransfer(word,pair);
